# ============================================================
#  MigrantIA · variables de entorno del servidor
#  Copia este archivo a .env y reemplaza los valores de ejemplo:
#      cp .env.example .env
#  .env está en .gitignore: NUNCA lo subas al repositorio.
# ============================================================

# --- Agente de Saptiva Studio (obligatorio para el chat) ---
# URL del webhook del workflow (Saptiva Studio → workflow → Webhook)
WEBHOOK_URL=https://api.laboratorioia.ibero.mx/builder/v1/public/webhooks/workflows/whk_REEMPLAZA_CON_TU_WEBHOOK
# Token del webhook; el servidor lo envía como "Authorization: Bearer <token>"
WEBHOOK_TOKEN=bwhsec_REEMPLAZA_CON_TU_TOKEN

# --- (Opcional) Un webhook distinto por caso ---
# Si están vacíos se usa WEBHOOK_URL.
WEBHOOK_URL_ALBERGUE=
WEBHOOK_URL_VIOLENCIA=
WEBHOOK_URL_MEDICA=
WEBHOOK_URL_DETENCION=
WEBHOOK_URL_TRATA=

# --- Servidor ---
PORT=3000
# HOST=0.0.0.0

# Tiempo máximo de espera de la respuesta del agente (ms).
# El agente ha tardado entre 30 y 105 s; si lo subes, sube también
# TIMEOUT_MS en public/js/config.js para que sea mayor que este.
TIMEOUT_MS=170000

# Límite de mensajes por IP en cada ventana (protege el webhook de abuso)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Detrás de un proxy o plataforma (Render, Railway, nginx) pon 1 para
# que el límite por IP use la IP real del visitante.
TRUST_PROXY=false

# true = registra en consola los eventos del agente, que INCLUYEN el
# texto de las respuestas. Úsalo solo en desarrollo.
DEBUG=false
